# GCP Core
PROJECT_ID=your-gcp-project-id
REGION=asia-south1
ZONE=asia-south1-a
GCS_MODEL_BUCKET=your-gcp-project-id-staging-models
ARTIFACT_REGISTRY_PATH=asia-south1-docker.pkg.dev/your-gcp-project-id/pricing/pricing-api

# App & Retrain Tokens
RETRAIN_TOKEN=dummy-retrain-token
MODEL_PATH=/path/to/model
MODEL_VERSION=v1.0
APP_BASE_URL=http://localhost:5000

# Observability
ELASTICSEARCH_URL=http://localhost:9200/pricing-logs-*/_search
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5080

# ChatOps & Jenkins Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/dummy
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/dummy
JENKINS_URL=http://localhost:8080/generic-webhook-trigger/invoke
JENKINS_RETRAIN_TOKEN=dummy-jenkins-token
