pipeline {
    agent any
    environment {
        PROJECT_ID = 'aditya-devops-lab'
        REGION = 'asia-south1'
        GAR_REPO = "${REGION}-docker.pkg.dev/${PROJECT_ID}/pricing/pricing-api"
        GIT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
        // Injected securely via Jenkins Credentials Plugin
        RETRAIN_TOKEN = credentials('pricing-api-retrain-token')
    }
    stages {
        stage('1. Checkout') { steps { checkout scm } }
        stage('2. Static Analysis & SonarQube Quality Gate') {
            environment {
                // This pulls the path of the tool you named 'sonar-scanner' in Jenkins
                SCANNER_HOME = tool 'sonar-scanner'
            }
            steps {
                sh '''
                if ! docker image inspect ${GAR_REPO}:latest >/dev/null 2>&1 && ! docker image inspect dynamic-pricing-api:local >/dev/null 2>&1; then
                    docker build -t dynamic-pricing-api:local -f Dockerfile .
                fi
                TEST_IMAGE=$(docker image inspect dynamic-pricing-api:local >/dev/null 2>&1 && echo "dynamic-pricing-api:local" || echo "${GAR_REPO}:latest")
                docker run --rm -u root -v "$(pwd):/workspace" -w /workspace ${TEST_IMAGE} \
                    pytest -o cache_dir=/tmp/.pytest_cache --cov=src --cov-report=xml:coverage.xml tests/test_api.py tests/test_model_singleton.py
                '''
                withSonarQubeEnv('SonarQube') {
                    sh "${SCANNER_HOME}/bin/sonar-scanner -Dproject.settings=cicd/sonar-project.properties"
                }
                timeout(time: 5, unit: 'MINUTES') { waitForQualityGate abortPipeline: true }
            }
        }
        stage('3. Build & Tag Docker Image') {
            steps {
                sh "docker build -t ${GAR_REPO}:${GIT_SHA} -t ${GAR_REPO}:latest -f Dockerfile ."
            }
        }
        stage('4. Push to Artifact Registry') {
            steps {
                sh "docker push ${GAR_REPO}:${GIT_SHA}"
                sh "docker push ${GAR_REPO}:latest"
            }
        }
        stage('5. Deploy to GKE') {
            steps {
                sh """
                gcloud container clusters get-credentials pricing-staging --zone asia-south1-a --project ${PROJECT_ID}
                kubectl set image deployment/pricing-api pricing-api=${GAR_REPO}:${GIT_SHA} -n pricing
                kubectl rollout status deployment/pricing-api -n pricing
                """
            }
        }
        stage('6. Post-Deploy Functional Test (Selenium)') {
            environment {
                APP_BASE_URL = 'https://pricing-staging.136.81.137.108.sslip.io'
                SELENIUM_REMOTE_URL = 'http://selenium:4444'
            }
            steps {
                sh '''
                mkdir -p reports/screenshots
                docker run --rm \
                    --network cicd_cicd-net \
                    -v "$(pwd)/reports/screenshots:/app/reports/screenshots" \
                    -e APP_BASE_URL=${APP_BASE_URL} \
                    -e SELENIUM_REMOTE_URL=${SELENIUM_REMOTE_URL} \
                    -e PYTHONPATH=/app \
                    -w /app \
                    ${GAR_REPO}:${GIT_SHA} pytest -o cache_dir=/tmp/.pytest_cache tests/test_ui_selenium.py || true
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/screenshots/**', allowEmptyArchive: true
                }
            }
        }
    }
}